# =============================================================================
# SocialPanel — copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio. NUNCA pongas aquí nada con prefijo
# NEXT_PUBLIC_ que no quieras ver en el navegador del usuario.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Project Settings → API Keys
# La publishable key (sb_publishable_...) es pública por diseño: la protege el RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 🔴 SOLO servidor (sb_secret_...). Salta todo el RLS. Si esto acaba en el bundle
# del cliente, cualquiera puede leer y borrar la base de datos entera.
SUPABASE_SECRET_KEY=

# --- Cifrado de credenciales BYOK ---------------------------------------------
# 32 bytes en base64. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# En producción muévela a un secret manager (Vercel env cifrado / AWS KMS).
CREDENTIALS_ENCRYPTION_KEY=

# --- Proveedores de IA (claves de plataforma, fallback si el tenant no trae la suya)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FAL_API_KEY=

# Cloudflare Workers AI: generador de imágenes del perfil gratuito.
# 10.000 neuronas/día sin tarjeta. El Account ID sale de la URL del panel.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Publicación --------------------------------------------------------------
UPLOAD_POST_API_KEY=

# --- Cola de jobs -------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Stripe -------------------------------------------------------------------
# 🔴 STRIPE_WEBHOOK_SECRET es obligatorio en producción: sin él no se puede
# verificar la firma, y un endpoint de facturación sin verificar es un
# formulario público para regalarse el plan Pro.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de precio (price_...), NO de producto. Los resuelve el servidor: el
# navegador solo manda "starter" o "pro".
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Rate limiting (opcional en dev; obligatorio en producción) ---------------
# Sin esto se usa un limitador en memoria que NO sirve con varias instancias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Config -------------------------------------------------------------------
APP_URL=http://localhost:3000
# Perfil de proveedores por defecto: "free" | "paid"
PROVIDER_PROFILE=free

# --- Modelos ------------------------------------------------------------------
# Configurables porque Google retira versiones sin aviso. Comprueba cuáles
# admite tu clave con:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TEXT_MODEL=gemini-3.7-flash
# OJO: la generación de imágenes NO tiene tier gratuito. Necesita facturación
# activada en el proyecto de Google o devuelve 429.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ANTHROPIC_MODEL=claude-sonnet-5
# Comparados los 4 de Cloudflare con el mismo prompt: lucid-origin gana en
# anatomía y no se inventa logos ni texto. flux-1-schnell es más rápido pero
# saca manos flotando y llegó a dibujar un logo de Apple.
CLOUDFLARE_IMAGE_MODEL=@cf/leonardo/lucid-origin
